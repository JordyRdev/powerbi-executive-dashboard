table FactLedger

	column month
		dataType: dateTime
		isHidden
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: month

	column segment_id
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: segment_id

	column ledger_revenue_eur
		dataType: decimal
		isHidden
		summarizeBy: none
		sourceColumn: ledger_revenue_eur

	partition FactLedger = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "fact_ledger.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
					Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
					Typed = Table.TransformColumnTypes(Headers, {{"month", type date}, {"segment_id", Int64.Type}, {"ledger_revenue_eur", Currency.Type}}, "en-US")
				in
					Typed
