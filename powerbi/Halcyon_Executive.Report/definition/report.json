{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/report/3.0.0/schema.json",
  "themeCollection": {
    "customTheme": {
      "name": "halcyon_dark.json",
      "reportVersionAtImport": {
        "visual": "2.4.0",
        "report": "3.0.0",
        "page": "2.0.0"
      },
      "type": "RegisteredResources"
    }
  },
  "objects": {
    "outspacePane": [
      {
        "properties": {
          "visible": {
            "expr": {
              "Literal": {
                "Value": "false"
              }
            }
          }
        }
      }
    ]
  },
  "resourcePackages": [
    {
      "name": "RegisteredResources",
      "type": "RegisteredResources",
      "items": [
        {
          "name": "halcyon_dark.json",
          "path": "halcyon_dark.json",
          "type": "CustomTheme"
        },
        {
          "name": "bg_overview.png",
          "path": "bg_overview.png",
          "type": "Image"
        },
        {
          "name": "bg_segments.png",
          "path": "bg_segments.png",
          "type": "Image"
        },
        {
          "name": "bg_trust.png",
          "path": "bg_trust.png",
          "type": "Image"
        }
      ]
    }
  ],
  "settings": {
    "useStylableVisualContainerHeader": true,
    "defaultDrillFilterOtherVisuals": true,
    "allowChangeFilterTypes": true,
    "useEnhancedTooltips": true
  }
}
